# External APIs
OPENAI_API_KEY=your_openai_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# App identity
APP_NAME=youtube-emotionscope
APP_VERSION=0.1.0
APP_ENV=development

# Demo / live behavior
DEMO_MODE_ENABLED=true
LIVE_MODE_ENABLED=true
APP_ACCESS_TOKEN=change-me
LIVE_REQUEST_LIMIT=3

# Models
GENERATION_PROVIDER=openai
CLASSIFICATION_MODEL=gpt-4o-mini
DESCRIPTION_MODEL=gpt-4o-mini

# Fetch
FETCH_ALL_COMMENTS=true
MAX_COMMENTS_TO_FETCH=1000
YOUTUBE_COMMENT_ORDER=relevance

# Preprocessing / sampling
SAMPLE_SIZE=60
RANDOM_SEED=42
MIN_TEXT_LENGTH=2
DEDUPLICATE_COMMENTS=true

# Batch classification
CLASSIFICATION_BATCH_SIZE=20

# Aggregation
TOP_PRIMARY_EMOTIONS_LIMIT=5
TOP_NUANCED_EMOTIONS_LIMIT=5
REPRESENTATIVE_COMMENTS_LIMIT=8
TIMELINE_BUCKET_COUNT=8
MIN_NUANCED_EMOTION_FREQUENCY=2

# Caching / artifacts
SAVE_ARTIFACTS=true
USE_CACHE=true
CACHE_DIR=data/cache
RAW_CACHE_DIR=data/cache/raw
ANALYSIS_CACHE_DIR=data/cache/analysis
ARTIFACTS_DIR=data/artifacts
RAW_ARTIFACTS_DIR=data/artifacts/raw
CLEANED_ARTIFACTS_DIR=data/artifacts/cleaned
SAMPLED_ARTIFACTS_DIR=data/artifacts/sampled
CLASSIFIED_ARTIFACTS_DIR=data/artifacts/classified
FINAL_ARTIFACTS_DIR=data/artifacts/final
DEMO_DATA_PATH=data/demo/demo_video_analysis.json

# Tracing
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=youtube-emotionscope-dev
LANGSMITH_API_KEY=key
